PORT=3000
NODE_ENV=development

# Supabase PostgreSQL connection string (required)
# Dashboard → Project Settings → Database → Connection string → URI
# Use the "Session mode" pooler or direct connection.
DATABASE_URL=postgresql://postgres.XXXX:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Set to false only for local PostgreSQL without SSL
# DATABASE_SSL=false

JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=24h
CORS_ORIGIN=*

# SMTP Email (SendGrid/Mailgun/Postmark/Brevo)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@jobfinder.com
