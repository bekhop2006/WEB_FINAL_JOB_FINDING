PORT=3000
DB_HOST=localhost
DB_PORT=27017
DB_NAME=job_finder_db
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=24h
CORS_ORIGIN=*

# Optional: Use MongoDB Atlas connection string instead
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/job_finder_db

# SMTP Email (SendGrid/Mailgun/Postmark)
# For SendGrid: host=smtp.sendgrid.net, user=apikey, pass=YOUR_SG_API_KEY
# For Mailgun: use your Mailgun SMTP credentials
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@jobfinder.com
