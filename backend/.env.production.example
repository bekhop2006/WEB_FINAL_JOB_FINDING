# Production — задайте эти переменные в Render/Railway Environment (не коммитьте значения).

NODE_ENV=production
PORT=3000

# MongoDB Atlas (обязательно)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/job_finder_db?retryWrites=true&w=majority

# JWT (обязательно). Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=ваш-64-символа-hex-секрет
JWT_EXPIRES_IN=24h

# CORS — URL вашего фронтенда
CORS_ORIGIN=https://your-app.onrender.com

# Brevo SMTP (опционально)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=ваш_login@smtp-brevo.com
SMTP_PASS=ваш_smtp_ключ_brevo
SMTP_FROM=ваш_login@smtp-brevo.com
