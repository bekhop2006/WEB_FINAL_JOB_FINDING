# Production — set these in Render/Railway/VPS Environment (do not commit secrets).

NODE_ENV=production
PORT=3000

# Supabase PostgreSQL (required)
# Project Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres.XXXX:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# JWT (required). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-64-char-hex-secret
JWT_EXPIRES_IN=24h

# CORS — URL of your frontend / public app
CORS_ORIGIN=https://your-app.onrender.com

# Brevo SMTP (optional)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_login@smtp-brevo.com
SMTP_PASS=your_smtp_key
SMTP_FROM=your_login@smtp-brevo.com
